From: Cromite <cromite@github.com>
Date: Thu, 10 Sep 2026 00:00:00 +0000
Subject: Disable incognito mode by default

Set kIncognitoModeAvailability default preference to 1 (Disabled).

License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
---
 chrome/browser/prefs/browser_prefs.cc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1767,6 +1767,8 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
   site_engagement::ImportantSitesUtil::RegisterProfilePrefs(registry);
   IncognitoModePrefs::RegisterProfilePrefs(registry);
+  registry->SetDefaultPrefValue(policy::policy_prefs::kIncognitoModeAvailability,
+                                base::Value(1));
   invalidation::PerUserTopicSubscriptionManager::RegisterProfilePrefs(registry);
   language::LanguagePrefs::RegisterProfilePrefs(registry);
